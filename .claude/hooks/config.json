{
  "hooks": {
    "pre-commit": {
      "enabled": true,
      "scripts": [
        ".claude/hooks/check-ascii.sh",
        ".claude/hooks/check-sql-format.sh",
        ".claude/hooks/block-main-edit.sh"
      ]
    },
    "post-edit": {
      "enabled": true,
      "scripts": [
        ".claude/hooks/validate-manifest.sh"
      ]
    },
    "pre-read": {
      "enabled": true,
      "scripts": [
        ".claude/hooks/check-branch.sh"
      ]
    }
  }
}