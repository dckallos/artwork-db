# =============================================================================
# Environment Variables -- Artwork Medallion Pipeline
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# =============================================================================

# --- Snowflake Runtime Connection (used by extraction/*) ---
# These credentials belong to the ARTWORK_LOADER_SVC service account created
# by infrastructure/V008__create_service_user.sql. Do NOT put a human login
# here -- the loader should always run as the scoped service user.
# (Phase 1A relies on this exact set of variable names; do not rename.)
SNOWFLAKE_ACCOUNT=your_account_identifier    # e.g., xy12345.us-east-1
SNOWFLAKE_USER=ARTWORK_LOADER_SVC            # Service account created by V008
SNOWFLAKE_PASSWORD=your_service_account_password
SNOWFLAKE_ROLE=ARTWORK_LOADER                # Service account's default role
SNOWFLAKE_WAREHOUSE=ARTWORK_WH
SNOWFLAKE_DATABASE=ARTWORK_DB

# --- Snowflake CLI (snow) connection selection (used by IaC: make iac / rollback / down) ---
# Admin credentials live in ~/.snowflake/config.toml (key-pair auth), NOT here.
# Optionally override the default snow CLI connection name for ad-hoc work:
# SNOW_CONNECTION=admin
#
# The SNOWFLAKE_PASSWORD above is also consumed by the snow CLI's `loader`
# connection via env-var precedence, so there is exactly one runtime
# credential to rotate (used by both Phase 1A and the snow CLI loader).

# --- API Keys ---
SMITHSONIAN_API_KEY=your_smithsonian_api_key  # Register at https://api.data.gov

# --- Extraction Config (optional overrides) ---
# EXTRACTION_BATCH_SIZE=5000
# EXTRACTION_CHECKPOINT_DIR=.checkpoints