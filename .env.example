# =============================================================================
# artwork-db .env template
# Copy to .env. Do not commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Local extraction paths and API tuning
# -----------------------------------------------------------------------------
MET_SQLITE_PATH=./data/met.db
MET_CSV_LOCAL_PATH=./data/MetObjects.csv

# Met allows high throughput; keep this polite by default for local work.
MET_API_CONCURRENCY=10
MET_API_RPS=20
MET_API_MAX_RETRIES=5
MET_API_TIMEOUT=30
MET_API_USER_AGENT="artwork-medallion-pipeline/1.0 (contact: daniel@porchanalytics.com)"
MET_UPLOAD_CHUNK=5000

AIC_DATA_DIR=./data
AIC_TAR_PATH=./data/aic_dump.tar.bz2
AIC_EXTRACT_DIR=./data/aic_extract

# Optional extraction checkpoint tuning.
# EXTRACTION_BATCH_SIZE=5000
# EXTRACTION_CHECKPOINT_DIR=.checkpoints

# -----------------------------------------------------------------------------
# Snowflake account shown in Account Details
# -----------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=DSHXYWJ-KW94245
SNOW_CONNECTION=kw94245

# -----------------------------------------------------------------------------
# Python extraction / loader service user
# -----------------------------------------------------------------------------
SNOWFLAKE_USER=ARTWORK_LOADER_SVC
SNOWFLAKE_PRIVATE_KEY_FILE=~/.snowflake/keys/kw94245_loader_rsa_key.p8
SNOWFLAKE_ROLE=ARTWORK_LOADER
SNOWFLAKE_WAREHOUSE=ARTWORK_WH
SNOWFLAKE_DATABASE=ARTWORK_DB
# SNOWFLAKE_SCHEMA=BRONZE
# SNOWFLAKE_PRIVATE_KEY_FILE_PWD=

# -----------------------------------------------------------------------------
# dbt transform service user
# -----------------------------------------------------------------------------
DBT_TARGET=dev
DBT_SNOWFLAKE_USER=ARTWORK_TRANSFORMER_SVC
DBT_SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/kw94245_transformer_rsa_key.p8
# DBT_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
DBT_SNOWFLAKE_ROLE=ARTWORK_TRANSFORMER
DBT_SNOWFLAKE_SCHEMA=dbt_daniel

# CI-style warehouse overrides. Local dev usually uses SNOWFLAKE_WAREHOUSE.
# DBT_STAGING_WAREHOUSE=ARTWORK_WH_STAGING
# DBT_PROD_WAREHOUSE=ARTWORK_WH_PROD

# -----------------------------------------------------------------------------
# snowflake-toolkit location and service-role defaults used by helper scripts
# -----------------------------------------------------------------------------
TOOLKIT_DIR=../snowflake-toolkit
SNOW_LIB_DEFAULT_WAREHOUSE=ARTWORK_WH
LOADER_USER=ARTWORK_LOADER_SVC
LOADER_ROLE=ARTWORK_LOADER
TRANSFORMER_USER=ARTWORK_TRANSFORMER_SVC
TRANSFORMER_ROLE=ARTWORK_TRANSFORMER

# Helper-script defaults. Override only when intentionally onboarding another account.
SNOW_ARTWORK_PROFILE=kw94245
SNOW_ARTWORK_ACCOUNT=DSHXYWJ-KW94245
SNOW_ARTWORK_ADMIN_USER=PORCHORCH
SNOW_ARTWORK_ADMIN_ROLE=ACCOUNTADMIN
SNOW_ARTWORK_INIT_WAREHOUSE=COMPUTE_WH
SNOW_ARTWORK_PROJECT_WAREHOUSE=ARTWORK_WH
SNOW_ARTWORK_DATABASE=ARTWORK_DB
SNOW_ARTWORK_DEV_SCHEMA_PREFIX=dbt_daniel
SNOW_ARTWORK_STAGING_WAREHOUSE=ARTWORK_WH_STAGING
SNOW_ARTWORK_PROD_WAREHOUSE=ARTWORK_WH_PROD
SNOW_ARTWORK_CI_STAGING_PROFILE=artwork_ci_staging
SNOW_ARTWORK_CI_PROD_PROFILE=artwork_ci_prod

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
SMITHSONIAN_API_KEY=your_smithsonian_api_key

# -----------------------------------------------------------------------------
# GitHub/Snowflake git-setup integration
# -----------------------------------------------------------------------------
# Leave these blank until you intentionally apply git-setup. Do not commit real values.
# scripts/setup/run_git_setup.sh checks that required values are present before applying.
GITHUB_PAT=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
