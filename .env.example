# =============================================================================
# artwork-db .env template
# Copy to .env. Do not commit .env.
# =============================================================================

# New Snowflake account shown in Account Details.
SNOWFLAKE_ACCOUNT=DSHXYWJ-KW94245
SNOW_CONNECTION=kw94245

# --- Python extraction / loader service user ---
SNOWFLAKE_USER=ARTWORK_LOADER_SVC
SNOWFLAKE_PRIVATE_KEY_FILE=~/.snowflake/keys/kw94245_loader_rsa_key.p8
SNOWFLAKE_ROLE=ARTWORK_LOADER
SNOWFLAKE_WAREHOUSE=ARTWORK_WH
SNOWFLAKE_DATABASE=ARTWORK_DB
# SNOWFLAKE_SCHEMA=BRONZE
# SNOWFLAKE_PRIVATE_KEY_FILE_PWD=

# --- dbt transform service user ---
DBT_TARGET=dev
DBT_SNOWFLAKE_USER=ARTWORK_TRANSFORMER_SVC
DBT_SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/kw94245_transformer_rsa_key.p8
# DBT_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
DBT_SNOWFLAKE_ROLE=ARTWORK_TRANSFORMER
DBT_SNOWFLAKE_SCHEMA=dbt_daniel
# Optional CI-style warehouse overrides. Local dev usually uses SNOWFLAKE_WAREHOUSE.
# DBT_STAGING_WAREHOUSE=ARTWORK_WH_STAGING
# DBT_PROD_WAREHOUSE=ARTWORK_WH_PROD

# --- Toolkit location ---
TOOLKIT_DIR=../snowflake-toolkit
SNOW_LIB_DEFAULT_WAREHOUSE=ARTWORK_WH
LOADER_USER=ARTWORK_LOADER_SVC
LOADER_ROLE=ARTWORK_LOADER
TRANSFORMER_USER=ARTWORK_TRANSFORMER_SVC
TRANSFORMER_ROLE=ARTWORK_TRANSFORMER

# --- External APIs ---
SMITHSONIAN_API_KEY=your_smithsonian_api_key

# --- GitHub/Snowflake git-setup integration ---
# Prefer passing secrets at apply time instead of storing them here:
#   make iac CONN=kw94245 VARS="github_pat=..."
# GITHUB_PAT=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# --- Extraction tuning ---
# EXTRACTION_BATCH_SIZE=5000
# EXTRACTION_CHECKPOINT_DIR=.checkpoints
