# =============================================================================
# Environment Variables -- Artwork Medallion Pipeline
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# =============================================================================

# --- Snowflake Runtime Connection (used by extraction/*) ---
# These credentials belong to the ARTWORK_LOADER_SVC service account created
# by infrastructure/create_service_user.sql. It is a TYPE = SERVICE user with
# NO password -- authentication is KEY-PAIR ONLY. Do NOT put a human login
# here -- the loader should always run as the scoped service user.
# (Phase 1A relies on this exact set of variable names; do not rename.)
SNOWFLAKE_ACCOUNT=your_account_identifier    # e.g., OBANOYY-MK07348 (ORGNAME-ACCOUNTNAME)
SNOWFLAKE_USER=ARTWORK_LOADER_SVC            # Service account (TYPE = SERVICE)
# Multi-account: the loader key is namespaced by the admin connection (CONN).
# Minted + registered by: make loader CONN=<conn>   (e.g. CONN=mk07348)
SNOWFLAKE_PRIVATE_KEY_FILE=~/.snowflake/keys/<conn>_loader_rsa_key.p8  # e.g. mk07348_loader_rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_FILE_PWD=...         # only if the key is encrypted
SNOWFLAKE_ROLE=ARTWORK_LOADER                # Service account's default role
SNOWFLAKE_WAREHOUSE=ARTWORK_WH
SNOWFLAKE_DATABASE=ARTWORK_DB

# --- Snowflake CLI (snow) connection selection (used by IaC: make iac / rollback / down) ---
# Admin credentials live in ~/.snowflake/config.toml (key-pair auth), NOT here.
# Optionally override the default snow CLI connection name for ad-hoc work:
# SNOW_CONNECTION=admin
#
# The snow CLI 'loader' connection authenticates with the SAME private key
# (configured under [connections.loader] in config.toml by
# setup.sh --phase loader), so there is exactly one key-pair credential shared
# by both Phase 1A and the snow CLI loader -- and no password anywhere.

# --- API Keys ---
SMITHSONIAN_API_KEY=your_smithsonian_api_key  # Register at https://api.data.gov

# --- dbt Transform Layer (used by dbt_orchestrate.sh + profiles.yml) ---
# These are consumed by env_var() in artwork_pipeline/profiles.yml.
# The ARTWORK_TRANSFORMER role has CREATE TABLE/VIEW on Silver/Gold + SELECT on Bronze.
# dbt (artwork_pipeline) authenticates as the ARTWORK_TRANSFORMER_SVC service
# user (TYPE = SERVICE, key-pair only), scoped to the ARTWORK_TRANSFORMER role.
# The key is namespaced per account and minted by: make transformer CONN=<conn>
DBT_SNOWFLAKE_USER=ARTWORK_TRANSFORMER_SVC
DBT_SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/<conn>_transformer_rsa_key.p8  # e.g. mk07348_transformer_rsa_key.p8
# DBT_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=       # only if the key is encrypted
DBT_SNOWFLAKE_ROLE=ARTWORK_TRANSFORMER

# --- Extraction Config (optional overrides) ---
# EXTRACTION_BATCH_SIZE=5000
# EXTRACTION_CHECKPOINT_DIR=.checkpoints