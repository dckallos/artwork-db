# profiles/profiles.yml.example
# dbt-snowflake profile for the OpenAccess Artwork Medallion Pipeline.
# All values resolve from the environment via env_var() -- no secrets live here,
# so this example installs verbatim to ~/.dbt/profiles.yml.
# Auth = key-pair (private_key_path); see scripts/snowflake_cli/ keypair setup.

artwork_pipeline:                 # must match profile: in artwork_pipeline/dbt_project.yml
  target: dev
  outputs:

    # Local development -- builds into the SILVER schema by default.
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      # Key-pair auth: point at a PEM key on disk; passphrase blank if unencrypted.
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE', '') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'ARTWORK_TRANSFORMER') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'ARTWORK_WH') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'ARTWORK_DB') }}"
      schema: "{{ env_var('SNOWFLAKE_SCHEMA', 'SILVER') }}"
      threads: "{{ env_var('SNOWFLAKE_THREADS', '4') | int }}"
      client_session_keep_alive: false

    # Production -- same connection, defaults to the GOLD schema.
    prod:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE', '') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'ARTWORK_TRANSFORMER') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'ARTWORK_WH') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'ARTWORK_DB') }}"
      schema: "{{ env_var('SNOWFLAKE_PROD_SCHEMA', 'GOLD') }}"
      threads: "{{ env_var('SNOWFLAKE_THREADS', '8') | int }}"
      client_session_keep_alive: false
