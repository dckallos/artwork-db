# Local paths (defaults shown)
MET_SQLITE_PATH=./data/met.db
MET_CSV_LOCAL_PATH=./data/MetObjects.csv

# API tuning. Met allows ~80 rps; 20 is a polite default and finishes
# ~471k rows in roughly 6-7 hours (well within the 24h budget).
MET_API_CONCURRENCY=10
MET_API_RPS=20
MET_API_MAX_RETRIES=5
MET_API_TIMEOUT=30
MET_API_USER_AGENT="artwork-db/1.0 (contact: daniel@porchanalytics.com)"

# Snowflake connection (required for `upload`). KEY-PAIR auth: ARTWORK_LOADER_SVC
# is a TYPE = SERVICE user with no password. Point at the loader private key
# minted by scripts/snowflake_cli/06_setup_loader_keypair.sh.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=ARTWORK_LOADER_SVC
SNOWFLAKE_PRIVATE_KEY_FILE=~/.snowflake/keys/loader_rsa_key.p8
# Only if you generated an ENCRYPTED key (the default is unencrypted):
# SNOWFLAKE_PRIVATE_KEY_FILE_PWD=your_key_passphrase
SNOWFLAKE_ROLE=ARTWORK_LOADER
SNOWFLAKE_WAREHOUSE=ARTWORK_WH
SNOWFLAKE_DATABASE=ARTWORK_DB
SNOWFLAKE_SCHEMA=BRONZE
SNOWFLAKE_TABLE=raw_met_objects
SNOWFLAKE_STAGE=bronze_load_stage

# Upload tuning: rows per NDJSON file / COPY INTO operation
MET_UPLOAD_CHUNK=5000