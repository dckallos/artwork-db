# AIC Extraction -- Environment Variables
# Copy to .env at the repo root and fill in your values.

# Local paths (defaults shown)
AIC_DATA_DIR=./data
AIC_TAR_PATH=./data/aic_dump.tar.bz2
AIC_EXTRACT_DIR=./data/aic_extract

# Override the dump URL only if the S3 path changes
# AIC_DUMP_URL=https://artic-api-data.s3.amazonaws.com/artic-api-data.tar.bz2

# Snowflake connection (required). KEY-PAIR auth: ARTWORK_LOADER_SVC is a
# TYPE = SERVICE user with no password. Point at the loader private key
# minted by `make loader CONN=<conn>`.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=ARTWORK_LOADER_SVC
SNOWFLAKE_PRIVATE_KEY_FILE=~/.snowflake/keys/mk07348_loader_rsa_key.p8
# Only if you generated an ENCRYPTED key (the default is unencrypted):
# SNOWFLAKE_PRIVATE_KEY_FILE_PWD=your_key_passphrase
SNOWFLAKE_ROLE=ARTWORK_LOADER
SNOWFLAKE_WAREHOUSE=ARTWORK_WH
SNOWFLAKE_DATABASE=ARTWORK_DB
SNOWFLAKE_SCHEMA=BRONZE
SNOWFLAKE_STAGE=bronze_load_stage
